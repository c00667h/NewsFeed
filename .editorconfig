root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.java]
indent_size = 2
# IntelliJ Java formatter：保留 Google 風格的 2 spaces，再加入團隊偏好的留白。
ij_java_blank_lines_after_class_header = 1
ij_java_blank_lines_before_method_body = 1
ij_java_blank_lines_before_return_statement = 1
ij_java_keep_blank_lines_in_code = 1

[*.xml]
indent_size = 2

[*.{ts,tsx}]
# IntelliJ 的 TypeScript formatter 也在 return 前保留一個空白行。
ij_javascript_blank_lines_before_return_statement = 1

[*.{yml,yaml}]
indent_size = 2
